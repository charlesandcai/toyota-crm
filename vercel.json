{
    "functions": {
        "api/**/*.php": {
            "runtime": "vercel-php@0.7.2"
        },
        "*.php": {
            "runtime": "vercel-php@0.7.2"
        }
    },
    "routes": [
        {
            "src": "/api/auth/login",
            "dest": "/api/auth/login.php"
        },
        {
            "src": "/dashboard",
            "dest": "/dashboard.php"
        },
        {
            "src": "/(.*)",
            "dest": "/index.php"
        }
    ]
}
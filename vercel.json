{
    "version": 2,
    "functions": {
        "views/**/*.php": {
            "runtime": "vercel-php@0.7.3"
        }
    },
    "rewrites": [
        {
            "source": "/",
            "destination": "/views/index.php"
        },
        {
            "source": "/login",
            "destination": "/views/index.php"
        },
        {
            "source": "/api/auth/login",
            "destination": "/views/auth/login.php"
        },
        {
            "source": "/dashboard",
            "destination": "/views/dashboard.php"
        }
    ]
}